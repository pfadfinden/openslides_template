{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "3378047577386894702"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "germanywestcentral"
    },
    "networkInterfaceName": {
      "type": "string",
      "defaultValue": "openslides4-nic"
    },
    "networkSecurityGroupName": {
      "type": "string",
      "defaultValue": "openslides4-nsg"
    },
    "networkSecurityGroupRules": {
      "type": "array",
      "defaultValue": [
        {
          "name": "allow-ssh",
          "properties": {
            "priority": 1000,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "Tcp",
            "sourcePortRange": "*",
            "destinationPortRange": "22",
            "sourceAddressPrefix": "*",
            "destinationAddressPrefix": "*"
          }
        },
        {
          "name": "allow-http",
          "properties": {
            "priority": 1010,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "Tcp",
            "sourcePortRange": "*",
            "destinationPortRange": "80",
            "sourceAddressPrefix": "*",
            "destinationAddressPrefix": "*"
          }
        },
        {
          "name": "allow-https",
          "properties": {
            "priority": 1020,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "Tcp",
            "sourcePortRange": "*",
            "destinationPortRange": "443",
            "sourceAddressPrefix": "*",
            "destinationAddressPrefix": "*"
          }
        }
      ]
    },
    "subnetName": {
      "type": "string",
      "defaultValue": "default"
    },
    "virtualNetworkName": {
      "type": "string",
      "defaultValue": "openslides4-vnet"
    },
    "addressPrefixes": {
      "type": "array",
      "defaultValue": [
        "10.0.0.0/16"
      ]
    },
    "subnets": {
      "type": "array",
      "defaultValue": [
        {
          "name": "[parameters('subnetName')]",
          "properties": {
            "addressPrefix": "10.0.0.0/24"
          }
        }
      ]
    },
    "publicIpAddressName": {
      "type": "string",
      "defaultValue": "openslides4-ip"
    },
    "publicIpAddressType": {
      "type": "string",
      "defaultValue": "Static"
    },
    "publicIpAddressSku": {
      "type": "string",
      "defaultValue": "Standard"
    },
    "pipDeleteOption": {
      "type": "string",
      "defaultValue": "Delete"
    },
    "virtualMachineName": {
      "type": "string",
      "defaultValue": "openslides4"
    },
    "virtualMachineComputerName": {
      "type": "string",
      "defaultValue": "openslides4"
    },
    "osDiskType": {
      "type": "string",
      "defaultValue": "StandardSSD_LRS"
    },
    "osDiskSizeGB": {
      "type": "int",
      "defaultValue": 64
    },
    "osDiskDeleteOption": {
      "type": "string",
      "defaultValue": "Delete"
    },
    "virtualMachineSize": {
      "type": "string",
      "defaultValue": "Standard_B2ms"
    },
    "nicDeleteOption": {
      "type": "string",
      "defaultValue": "Delete"
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "os4user"
    },
    "adminPassword": {
      "type": "securestring"
    },
    "openslidesSubdomain": {
      "type": "string"
