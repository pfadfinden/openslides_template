{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "7165857789471840485"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "germanywestcentral",
      "metadata": {
        "description": "Azure-Region, in der alles angelegt wird (z. B. germanywestcentral)"
      }
    },
    "networkInterfaceName": {
      "type": "string",
      "defaultValue": "openslides4-nic",
      "metadata": {
        "description": "Name der Netzwerkkarte (NIC) der VM — nur ändern, wenn nötig"
      }
    },
    "networkSecurityGroupName": {
      "type": "string",
      "defaultValue": "openslides4-nsg",
      "metadata": {
        "description": "Name der Netzwerksicherheitsgruppe (NSG) — nur ändern, wenn nötig"
      }
    },
    "networkSecurityGroupRules": {
      "type": "array",
      "defaultValue": [
        {
          "name": "allow-ssh",
          "properties": {
            "priority": 1000,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "Tcp",
            "sourcePortRange": "*",
            "destinationPortRange": "22",
            "sourceAddressPrefix": "*",
            "destinationAddressPrefix": "*"
          }
        },
        {
          "name": "allow-http",
          "properties": {
            "priority": 1010,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "Tcp",
            "sourcePortRange": "*",
            "destinationPortRange": "80",
            "sourceAddressPrefix": "*",
            "destinationAddressPrefix": "*"
          }
        },
        {
          "name": "allow-https",
          "properties": {
            "priority": 1020,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "Tcp",
            "sourcePortRange": "*",
            "destinationPortRange": "443",
            "sourceAddressPrefix": "*",
            "destinationAddressPrefix": "*"
          }
        }
      ],
      "metadata": {
        "description": "Eingangsregeln der Firewall: offen sind 22 (SSH), 80 und 443 (OpenSlides/HTTPS)"
      }
    },
    "subnetName": {
      "type": "string",
      "defaultValue": "default",
      "metadata": {
        "description": "Name des Subnetzes im VNet"
      }
    },
    "virtualNetworkName": {
      "type": "string",
      "defaultValue": "openslides4-vnet",
      "metadata": {
        "description": "Name des virtuellen Netzwerks (VNet)"
      }
    },
    "addressPrefixes": {
      "type": "array",
      "defaultValue": [
        "10.0.0.0/16"
      ],
      "metadata": {
        "description": "Adressbereich des VNet, z. B. 10.0.0.0/16"
      }
    },
    "subnets": {
      "type": "array",
      "defaultValue": [
        {
          "name": "[parameters('subnetName')]",
          "properties": {
            "addressPrefix": "10.0.0.0/24"
          }
        }
      ],
      "metadata": {
        "description": "Subnetze des VNet (Name + Adressbereich)"
      }
    },
    "publicIpAddressName": {
      "type": "string",
      "defaultValue": "openslides4-ip",
      "metadata": {
        "description": "Name der öffentlichen IP-Adresse der VM"
      }
    },
    "publicIpAddressType": {
      "type": "string",
      "defaultValue": "Static",
      "metadata": {
        "description": "Allokationsmethode der öffentlichen IP — Static empfohlen, damit die IP stabil bleibt"
      }
    },
    "publicIpAddressSku": {
      "type": "string",
      "defaultValue": "Standard",
      "metadata": {
        "description": "SKU der öffentlichen IP — Standard ist Pflicht zusammen mit der NSG"
      }
    },
    "pipDeleteOption": {
      "type": "string",
      "defaultValue": "Delete",
      "metadata": {
        "description": "Was mit der öffentlichen IP passiert, wenn die VM gelöscht wird"
      }
    },
    "virtualMachineName": {
      "type": "string",
      "defaultValue": "openslides4",
      "metadata": {
        "description": "Name der VM in Azure"
      }
    },
    "virtualMachineComputerName": {
      "type": "string",
      "defaultValue": "openslides4",
      "metadata": {
        "description": "Hostname innerhalb der VM"
      }
    },
    "osDiskType": {
      "type": "string",
      "defaultValue": "StandardSSD_LRS",
      "metadata": {
        "description": "Speichertyp der OS-Disk — StandardSSD_LRS ist günstig und für OpenSlides ausreichend"
      }
    },
    "osDiskSizeGB": {
      "type": "int",
      "defaultValue": 64,
      "metadata": {
        "description": "Größe der OS-Disk in GB — 64 GB empfohlen (Docker-Images + Datenbank)"
      }
    },
    "osDiskDeleteOption": {
      "type": "string",
      "defaultValue": "Delete",
      "metadata": {
        "description": "Was mit der OS-Disk passiert, wenn die VM gelöscht wird"
      }
    },
    "virtualMachineSize": {
      "type": "string",
      "defaultValue": "Standard_B2ms",
      "metadata": {
        "description": "VM-Größe — Standard_B2ms (2 vCPU / 8 GB, burstable: drosselt bei Dauerlast)"
      }
    },
    "nicDeleteOption": {
      "type": "string",
      "defaultValue": "Delete",
      "metadata": {
        "description": "Was mit der Netzwerkkarte passiert, wenn die VM gelöscht wird"
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "os4user",
      "metadata": {
        "description": "SSH-Benutzername auf der VM"
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "SSH-Passwort für den VM-Benutzer — bitte ein starkes Passwort wählen"
      }
    },
    "openslidesSubdomain": {
      "type": "string",
      "metadata": {
        "description": "Deine Subdomain, z. B. openslides.example.org — wird in EXTERNAL_ADDRESS und SYSTEM_URL eingetragen"
      }
    },
    "smtpHost": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "SMTP-Server für ausgehende E-Mails (Einladungen, Passwort-Reset), z. B. smtp.example.org"
      }
    },
    "smtpUser": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "SMTP-Benutzername, wird auch als DEFAULT_FROM_EMAIL verwendet"
      }
    },
    "smtpPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "SMTP-Passwort"
      }
    },
    "alertEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "E-Mail-Adresse für Monitoring-Alerts (leer = keine Alerts). Meldet dauerhaft hohe CPU-Last — die B2ms-VM ist burstable und drosselt, sobald die CPU-Credits aufgebraucht sind."
      }
    },
    "securityType": {
      "type": "string",
      "defaultValue": "TrustedLaunch",
      "metadata": {
        "description": "Sicherheitstyp der VM — TrustedLaunch aktiviert Secure Boot + vTPM (empfohlen)"
      }
    },
    "secureBoot": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Secure Boot aktivieren (nur mit TrustedLaunch)"
      }
    },
    "vTPM": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "virtuelles TPM (vTPM) aktivieren (nur mit TrustedLaunch)"
      }
    }
  },
  "variables": {
    "nsgId": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', parameters('networkSecurityGroupName'))]",
    "vnetId": "[resourceId(resourceGroup().name, 'Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]",
    "subnetRef": "[format('{0}/subnets/{1}', variables('vnetId'), parameters('subnetName'))]",
    "cloudInitYaml": "#cloud-config\ntimezone: Europe/Berlin\npackage_update: true\npackage_upgrade: true\npackages:\n  - ca-certificates\n  - curl\n  - gnupg\nwrite_files:\n  - path: /home/os4user/my-config.yml\n    permissions: '0644'\n    content: |\n      ---\n      host: 0.0.0.0\n      port: 443\n      enableAutoHTTPS: true\n      enableLocalHTTPS: false\n      services:\n        proxy:\n          environment:\n            EXTERNAL_ADDRESS: subdomain.pfadfinden.de\n        backendAction:\n          environment:\n            EMAIL_HOST: smtpHostHier.pfadfinden.de\n            EMAIL_PORT: 587\n            EMAIL_HOST_USER: \"mailAddyHier@pfadfinden.de\"\n            EMAIL_HOST_PASSWORD: ''\n            EMAIL_CONNECTION_SECURITY: \"STARTTLS\"  # This can also be \"NONE\" or \"STARTTLS\".\n            EMAIL_TIMEOUT: 5  # Timeout in seconds for blocking operations like the connection attempt.\n            EMAIL_ACCEPT_SELF_SIGNED_CERTIFICATE: \"false\"  # Or \"true\" of course.\n            DEFAULT_FROM_EMAIL: \"mailAddyHier@pfadfinden.de\"\n      defaultEnvironment:\n        SYSTEM_URL: subdomain.pfadfinden.de\n    owner: os4user:os4user\nruncmd:\n  - install -m 0755 -d /etc/apt/keyrings\n  - curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg\n  - chmod a+r /etc/apt/keyrings/docker.gpg\n  - echo \"deb [arch=\"$(dpkg --print-architecture)\" signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian \"$(. /etc/os-release && echo \"$VERSION_CODENAME\")\" stable\" | tee /etc/apt/sources.list.d/docker.list > /dev/null\n  - apt update\n  - apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin\n  - wget -P /home/os4user https://github.com/OpenSlides/openslides-manage-service/releases/download/latest/openslides\n  - chmod +x /home/os4user/openslides\n  - /home/os4user/openslides setup --config /home/os4user/my-config.yml /home/os4user\n  - sed -i '/      - 0.0.0.0:443:8000/i\\      - 0.0.0.0:80:8001' /home/os4user/docker-compose.yml\n  - docker compose -f /home/os4user/docker-compose.yml pull\n  - docker compose -f /home/os4user/docker-compose.yml up -d\n  - sleep 60\n  - cd /home/os4user\n  - /home/os4user/openslides initial-data -a subdomain.pfadfinden.de:443\n  - chown -R os4user:os4user /home/os4user\n",
    "smtpPasswordPlaceholder": "[concat('EMAIL_HOST_PASSWORD: ', ''', ''')]",
    "smtpPasswordLine": "[format('EMAIL_HOST_PASSWORD: \"{0}\"', parameters('smtpPassword'))]",
    "cloudInitRendered": "[replace(replace(replace(replace(variables('cloudInitYaml'), 'subdomain.pfadfinden.de', parameters('openslidesSubdomain')), 'smtpHostHier.pfadfinden.de', parameters('smtpHost')), 'mailAddyHier@pfadfinden.de', parameters('smtpUser')), variables('smtpPasswordPlaceholder'), variables('smtpPasswordLine'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2021-08-01",
      "name": "[parameters('networkInterfaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[variables('subnetRef')]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/publicIpAddresses', parameters('publicIpAddressName'))]",
                "properties": {
                  "deleteOption": "[parameters('pipDeleteOption')]"
                }
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[variables('nsgId')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('networkSecurityGroupName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpAddressName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2019-02-01",
      "name": "[parameters('networkSecurityGroupName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": "[parameters('networkSecurityGroupRules')]"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-07-01",
      "name": "[parameters('virtualNetworkName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": "[parameters('addressPrefixes')]"
        },
        "subnets": "[parameters('subnets')]"
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2020-08-01",
      "name": "[parameters('publicIpAddressName')]",
      "location": "[parameters('location')]",
      "properties": {
        "publicIPAllocationMethod": "[parameters('publicIpAddressType')]"
      },
      "sku": {
        "name": "[parameters('publicIpAddressSku')]"
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2022-03-01",
      "name": "[parameters('virtualMachineName')]",
      "location": "[parameters('location')]",
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('virtualMachineSize')]"
        },
        "storageProfile": {
          "osDisk": {
            "createOption": "fromImage",
            "diskSizeGB": "[parameters('osDiskSizeGB')]",
            "managedDisk": {
              "storageAccountType": "[parameters('osDiskType')]"
            },
            "deleteOption": "[parameters('osDiskDeleteOption')]"
          },
          "imageReference": {
            "publisher": "debian",
            "offer": "debian-12",
            "sku": "12-gen2",
            "version": "latest"
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('networkInterfaceName'))]",
              "properties": {
                "deleteOption": "[parameters('nicDeleteOption')]"
              }
            }
          ]
        },
        "osProfile": {
          "computerName": "[parameters('virtualMachineComputerName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "linuxConfiguration": {
            "patchSettings": {
              "patchMode": "ImageDefault"
            }
          },
          "customData": "[base64(variables('cloudInitRendered'))]"
        },
        "securityProfile": {
          "securityType": "[parameters('securityType')]",
          "uefiSettings": {
            "secureBootEnabled": "[parameters('secureBoot')]",
            "vTpmEnabled": "[parameters('vTPM')]"
          }
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', parameters('networkInterfaceName'))]"
      ]
    },
    {
      "condition": "[not(equals(parameters('alertEmail'), ''))]",
      "type": "Microsoft.Insights/actionGroups",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}-alerts', parameters('virtualMachineName'))]",
      "location": "global",
      "properties": {
        "groupShortName": "os4alerts",
        "enabled": true,
        "emailReceivers": [
          {
            "name": "admin",
            "emailAddress": "[parameters('alertEmail')]",
            "useCommonAlertSchema": true
          }
        ]
      }
    },
    {
      "condition": "[not(equals(parameters('alertEmail'), ''))]",
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[format('{0}-high-cpu', parameters('virtualMachineName'))]",
      "location": "global",
      "properties": {
        "description": "Dauerhaft hohe CPU-Last: Die B2ms-VM ist burstable und drosselt, sobald die CPU-Credits aufgebraucht sind.",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[resourceId('Microsoft.Compute/virtualMachines', parameters('virtualMachineName'))]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "criterionType": "StaticThresholdCriterion",
              "name": "HighAverageCpu",
              "metricName": "Percentage CPU",
              "operator": "GreaterThan",
              "threshold": 80,
              "timeAggregation": "Average",
              "dimensions": []
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', format('{0}-alerts', parameters('virtualMachineName')))]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', format('{0}-alerts', parameters('virtualMachineName')))]",
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('virtualMachineName'))]"
      ]
    }
  ],
  "outputs": {
    "adminUsername": {
      "type": "string",
      "value": "[parameters('adminUsername')]"
    },
    "publicIpAddress": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpAddressName')), '2020-08-01').ipAddress]"
    }
  }
}